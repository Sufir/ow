graph "MC-3P" {
  layout=neato; overlap=false; splines=true;
  node [shape=ellipse, fontname="Helvetica"];
  "MR-L3-AUS" [label="Australia\nAUSTRALIA · deg 2", style=filled, fillcolor="#fdd0a2"];
  "MR-L3-NAM" [label="North America\nNORTH_AMERICA · deg 4", style=filled, fillcolor="#fdd0a2"];
  "MR-L3-SAM" [label="South America\nSOUTH_AMERICA · deg 5", style=filled, fillcolor="#fdd0a2"];
  "MR-OC-ARC" [label="Arctic Ocean\nARCTIC · deg 5", style=filled, fillcolor="#9ecae1"];
  "MR-OC-IND" [label="Indian Ocean\nINDIAN · deg 7", style=filled, fillcolor="#9ecae1"];
  "MR-OC-NATL" [label="North Atlantic\nATLANTIC · deg 8", style=filled, fillcolor="#9ecae1"];
  "MR-OC-NPAC" [label="North Pacific\nPACIFIC · deg 7", style=filled, fillcolor="#9ecae1"];
  "MR-OC-SATL" [label="South Atlantic\nATLANTIC · deg 6", style=filled, fillcolor="#9ecae1"];
  "MR-OC-SPAC" [label="South Pacific\nPACIFIC · deg 6", style=filled, fillcolor="#9ecae1"];
  "MR-R3-AFR" [label="Africa\nAFRICA · deg 4", style=filled, fillcolor="#fdd0a2"];
  "MR-R3-ASI" [label="Asia\nASIA · deg 6", style=filled, fillcolor="#fdd0a2"];
  "MR-R3-EUR" [label="Europe\nEUROPE · deg 3", style=filled, fillcolor="#fdd0a2"];
  "MR-SH-ANT" [label="Antarctica\nANTARCTICA · deg 3", style=filled, fillcolor="#fdd0a2"];
  "MR-L3-AUS" -- "MR-OC-IND";
  "MR-L3-AUS" -- "MR-OC-SPAC";
  "MR-L3-NAM" -- "MR-L3-SAM";
  "MR-L3-NAM" -- "MR-OC-NATL";
  "MR-L3-NAM" -- "MR-OC-NPAC";
  "MR-L3-SAM" -- "MR-OC-SATL";
  "MR-L3-SAM" -- "MR-OC-SPAC";
  "MR-OC-ARC" -- "MR-L3-NAM";
  "MR-OC-ARC" -- "MR-OC-NATL";
  "MR-OC-ARC" -- "MR-OC-NPAC";
  "MR-OC-ARC" -- "MR-R3-ASI";
  "MR-OC-ARC" -- "MR-R3-EUR";
  "MR-OC-IND" -- "MR-OC-NPAC";
  "MR-OC-IND" -- "MR-OC-SATL";
  "MR-OC-IND" -- "MR-OC-SPAC";
  "MR-OC-NATL" -- "MR-L3-SAM";
  "MR-OC-NATL" -- "MR-OC-NPAC";
  "MR-OC-NATL" -- "MR-OC-SATL";
  "MR-OC-NPAC" -- "MR-L3-SAM";
  "MR-OC-NPAC" -- "MR-OC-SPAC";
  "MR-OC-SATL" -- "MR-OC-SPAC";
  "MR-R3-AFR" -- "MR-OC-IND";
  "MR-R3-AFR" -- "MR-OC-NATL";
  "MR-R3-AFR" -- "MR-OC-SATL";
  "MR-R3-AFR" -- "MR-R3-ASI";
  "MR-R3-ASI" -- "MR-OC-IND";
  "MR-R3-ASI" -- "MR-OC-NATL";
  "MR-R3-ASI" -- "MR-OC-NPAC";
  "MR-R3-ASI" -- "MR-R3-EUR";
  "MR-R3-EUR" -- "MR-OC-NATL";
  "MR-SH-ANT" -- "MR-OC-IND";
  "MR-SH-ANT" -- "MR-OC-SATL";
  "MR-SH-ANT" -- "MR-OC-SPAC";
}
